# Copy to .env (gitignored) and fill in. Never commit real values.
# Base URL of the Kintone site, e.g. https://yourcompany.kintone.com
KINTONE_BASE_URL=
# Numeric app ID of the directory app (use the dev app until production is approved)
KINTONE_APP_ID=
# Admin/setup token needs View records + Manage app. Runtime lookups should use a
# separate token with View records only.
KINTONE_API_TOKEN=

# Daily SharePoint export (only needed by the export job)
# App registration with the Graph application permission Sites.Selected,
# granted write access to the one site below.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# e.g. contoso.sharepoint.com
SHAREPOINT_HOST=
# e.g. /sites/StoreOperations
SHAREPOINT_SITE_PATH=
# Document library name; blank uses the site's default Documents library
SHAREPOINT_LIBRARY=
# Folder inside the library, e.g. Store Directory (blank = library root)
SHAREPOINT_FOLDER=
EXPORT_FILE_NAME=Angies Store Directory.xlsx
